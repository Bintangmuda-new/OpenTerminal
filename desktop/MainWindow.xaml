                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="ENTRY"
                               Style="{StaticResource WidgetLabelStyle}"/>
                    <TextBlock x:Name="ResultTotalText"
                               Text="0"
                               FontFamily="Consolas"
                               FontSize="17"
                               Foreground="#E7EDF5"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="PROFIT"
                               Style="{StaticResource WidgetLabelStyle}"/>
                    <TextBlock x:Name="ResultWinText"
                               Text="0"
                               FontFamily="Consolas"
                               FontSize="17"
                               Foreground="#25C89A"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="LOSS"
                               Style="{StaticResource WidgetLabelStyle}"/>
                    <TextBlock x:Name="ResultLossText"
                               Text="0"
                               FontFamily="Consolas"
                               FontSize="17"
