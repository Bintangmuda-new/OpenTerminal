                         Text="Candle tertutup: — · info"
                         FontFamily="Consolas"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="#E7B65A"
                         HorizontalAlignment="Stretch"
                         TextAlignment="Center"
                         VerticalAlignment="Bottom"
