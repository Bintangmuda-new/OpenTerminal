                          <TextBlock Text="{Binding Symbol}"
                                     FontFamily="Consolas"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Detail}"
                                     Foreground="#7890AC"
                                     FontSize="9"
                                     TextTrimming="CharacterEllipsis"/>
