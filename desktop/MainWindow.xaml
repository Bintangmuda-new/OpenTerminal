                    <TextBlock x:Name="ResultDrawText"
                               Text="0"
                               FontFamily="Consolas"
                               FontSize="17"
                               Foreground="#E7B65A"/>
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="5,2">
                  <Button Content="Buka Jurnal"
                          Click="OpenJournal_Click"
                          ToolTip="data/signal-journal.csv"/>
                  <Button Content="Reset"
                          Click="ResultReset_Click"
                          ToolTip="Kosongkan statistik sesi ini"/>
                </StackPanel>
                <TextBlock Grid.Row="3"
                           Margin="10,6"
                           Foreground="#9FB3CC"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Text="Hasil dihitung dari close vs open candle entry. DRAW = candle flat, stake kembali. Statistik ini sesi berjalan saja; riwayat penuh ada di signal-journal.csv. Filter volatilitas + z-score: 50,61% holdout (batas bawah 95% 49,7%). Tetap UNPROVEN. Angka di bawah 100 entry belum berarti."/>
              </Grid>
