                     FontFamily="Consolas"
                     FontSize="11"
                     Foreground="#72E3C3"
                     Margin="0,0,10,0"/>
          <TextBlock x:Name="BottomAlertMessage"
                     Foreground="#DCE7F4"
                     FontSize="12"
                     TextWrapping="Wrap"
                     MaxWidth="760"/>
        </StackPanel>
      </Border>
    </Grid>
    <Border x:Name="StartupBlankOverlay"
            Panel.ZIndex="1000"
            Background="#FF050A10"
            Visibility="Visible">
      <Grid ClipToBounds="True">
        <Rectangle Height="1"
                   VerticalAlignment="Top"
                   Fill="#1631D2F2"
                   Opacity="0.55"/>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock Text="OPEN TERMINAL"
                     HorizontalAlignment="Center"
                     FontFamily="Consolas"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="#54738A"
                     Margin="0,0,0,12"/>
          <TextBlock x:Name="StartupLoadingText"
                     Text="LOADING..."
                     HorizontalAlignment="Center"
                     FontFamily="Consolas"
                     FontSize="30"
                     FontWeight="Bold"
                     Foreground="#31D2F2">
            <TextBlock.Effect>
              <DropShadowEffect Color="#31D2F2"
                                BlurRadius="18"
                                ShadowDepth="0"
                                Opacity="0.75"/>
            </TextBlock.Effect>
          </TextBlock>
          <Border Width="200"
                  Height="2"
                  Margin="0,16,0,0"
                  Background="#182638">
            <Border x:Name="StartupLoadingPulse"
                    Width="42"
                    HorizontalAlignment="Left"
                    Background="#31D2F2">
              <Border.Effect>
                <DropShadowEffect Color="#31D2F2"
                                  BlurRadius="8"
                                  ShadowDepth="0"
                                  Opacity="0.9"/>
              </Border.Effect>
            </Border>
          </Border>
          <TextBlock Text="INITIALIZING MARKET FEED"
                     HorizontalAlignment="Center"
                     FontFamily="Consolas"
                     FontSize="9"
                     Foreground="#587086"
                     Margin="0,10,0,0"/>
        </StackPanel>
        <Rectangle Height="2"
                   VerticalAlignment="Top"
                   Fill="#3131D2F2"
                   IsHitTestVisible="False">
          <Rectangle.RenderTransform>
            <TranslateTransform x:Name="StartupScanTransform"/>
          </Rectangle.RenderTransform>
        </Rectangle>
      </Grid>
    </Border>
  </DockPanel>
</Window>
