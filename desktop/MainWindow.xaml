                            Padding="0,6,0,0">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="JURNAL"
                                     Style="{StaticResource WidgetLabelStyle}"
                                     FontSize="9"
                                     VerticalAlignment="Center"/>
                          <TextBlock x:Name="JournalRateText"
                                     Grid.Column="1"
                                     Text="—"
                                     FontFamily="Consolas"
                                     FontSize="15"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Right"
                                     Foreground="#E7EDF5"/>
                        </Grid>
                        <TextBlock x:Name="JournalDetailText"
                                   Text="belum ada data jurnal"
                                   Style="{StaticResource WidgetLabelStyle}"
