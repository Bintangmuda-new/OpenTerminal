              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="STRUCTURE · PATTERN"
                         Style="{StaticResource WidgetTitleStyle}"/>
              <Grid Grid.Row="1"
                    Margin="0,5,0,2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="StructCandlePattern"
                           Style="{StaticResource WidgetDataStyle}"
                           Margin="0,1"/>
                <TextBlock x:Name="StructChartPattern"
                           Grid.Row="1"
                           Style="{StaticResource WidgetDataStyle}"
                           Margin="0,1"/>
                <TextBlock x:Name="StructTrend"
                           Grid.Row="2"
                           Style="{StaticResource WidgetDataStyle}"
                           Margin="0,1"/>
                <TextBlock x:Name="StructBos"
                           Grid.Row="3"
                           Style="{StaticResource WidgetDataStyle}"
                           Margin="0,1"/>
                <TextBlock x:Name="StructSupportResistance"
                           Grid.Row="4"
                           Style="{StaticResource WidgetDataStyle}"
                           Margin="0,1"
