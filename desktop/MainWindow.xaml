<Window x:Class="OpenTerminal.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OPEN TERMINAL BMF"
        Width="1600"
        Height="960"
        MinWidth="640"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="#E6EDF5"
        SizeChanged="Window_SizeChanged">
  <Window.Resources>
    <Style x:Key="DarkScrollThumb"
           TargetType="Thumb">
      <Setter Property="IsTabStop"
              Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbBorder"
                    Background="#000000"
                    BorderBrush="#2A3442"
                    BorderThickness="1"
                    CornerRadius="3"
                    Margin="1"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver"
                       Value="True">
                <Setter TargetName="ThumbBorder"
                        Property="Background"
                        Value="#141A24"/>
              </Trigger>
              <Trigger Property="IsDragging"
                       Value="True">
                <Setter TargetName="ThumbBorder"
                        Property="Background"
                        Value="#1C2533"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkScrollPage"
           TargetType="RepeatButton">
      <Setter Property="IsTabStop"
              Value="False"/>
      <Setter Property="Focusable"
              Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background"
              Value="#000000"/>
      <Setter Property="Width"
              Value="10"/>
      <Setter Property="MinWidth"
              Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="#000000">
              <Track x:Name="PART_Track"
                     IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource DarkScrollPage}"
                                Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource DarkScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource DarkScrollPage}"
                                Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation"
                 Value="Horizontal">
          <Setter Property="Width"
                  Value="Auto"/>
          <Setter Property="MinWidth"
                  Value="0"/>
          <Setter Property="Height"
                  Value="10"/>
          <Setter Property="MinHeight"
                  Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Border Background="#000000">
                  <Track x:Name="PART_Track"
                         IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource DarkScrollPage}"
                                    Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource DarkScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource DarkScrollPage}"
                                    Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <SolidColorBrush x:Key="Panel"
                     Color="#000000"/>
    <SolidColorBrush x:Key="Panel2"
                     Color="#000000"/>
    <SolidColorBrush x:Key="Border"
                     Color="#2A313B"/>
    <Style x:Key="WidgetLabelStyle"
           TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="#9FB3CC"/>
      <Setter Property="FontFamily"
              Value="Segoe UI"/>
      <Setter Property="FontSize"
              Value="9"/>
      <Setter Property="VerticalAlignment"
              Value="Center"/>
    </Style>
    <Style x:Key="WidgetDataStyle"
           TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="#DCE7F4"/>
      <Setter Property="FontFamily"
              Value="Consolas"/>
      <Setter Property="FontSize"
              Value="10"/>
      <Setter Property="TextTrimming"
              Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment"
              Value="Center"/>
    </Style>
    <Style x:Key="WidgetTitleStyle"
           TargetType="TextBlock">
      <Setter Property="Foreground"
              Value="#9AA9B8"/>
      <Setter Property="FontWeight"
              Value="Bold"/>
      <Setter Property="FontSize"
              Value="10"/>
      <Setter Property="TextAlignment"
              Value="Center"/>
      <Setter Property="HorizontalAlignment"
              Value="Stretch"/>
      <Setter Property="VerticalAlignment"
              Value="Center"/>
      <Setter Property="Margin"
              Value="0,0,0,5"/>
      <Setter Property="Opacity"
              Value="0.95"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin"
              Value="3"/>
      <Setter Property="Padding"
              Value="10,6"/>
      <Setter Property="Background"
              Value="{StaticResource Panel2}"/>
      <Setter Property="Foreground"
              Value="#B8C7D9"/>
      <Setter Property="BorderBrush"
              Value="{StaticResource Border}"/>
      <Setter Property="Cursor"
              Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin"
              Value="4"/>
      <Setter Property="Padding"
              Value="9,7"/>
      <Setter Property="Background"
              Value="#000000"/>
      <Setter Property="Foreground"
              Value="#E7EDF5"/>
      <Setter Property="BorderBrush"
              Value="{StaticResource Border}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin"
              Value="4"/>
      <Setter Property="Padding"
              Value="7,4"/>
      <Setter Property="Background"
              Value="#000000"/>
      <Setter Property="Foreground"
              Value="#E7EDF5"/>
      <Setter Property="BorderBrush"
              Value="{StaticResource Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle"
                            Background="{TemplateBinding Background}"
                            Foreground="{TemplateBinding Foreground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Focusable="False">
                <Grid>
                  <ContentPresenter Margin="{TemplateBinding Padding}"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    VerticalAlignment="Center"/>
                  <Path Data="M 0 0 L 8 0 L 4 5 Z"
                        Fill="#A3B8D0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="6"/>
                </Grid>
              </ToggleButton>
              <Popup x:Name="Popup"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     PopupAnimation="Fade">
                <Border Background="#000000"
                        BorderBrush="#2E4863"
                        BorderThickness="1"
                        MinWidth="{Binding ActualWidth, ElementName=Toggle}">
                  <ScrollViewer MaxHeight="260">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background"
              Value="#000000"/>
      <Setter Property="Foreground"
              Value="#E7EDF5"/>
      <Setter Property="Padding"
              Value="8,5"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted"
                 Value="True">
          <Setter Property="Background"
                  Value="#17334B"/>
        </Trigger>
        <Trigger Property="IsSelected"
                 Value="True">
          <Setter Property="Background"
                  Value="#1F3E59"/>
          <Setter Property="Foreground"
                  Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Background"
              Value="#000000"/>
      <Setter Property="Foreground"
              Value="#DCE7F4"/>
      <Setter Property="Padding"
              Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid>
              <Border x:Name="ItemBorder"
                      Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                  </Grid.ColumnDefinitions>
                  <Path x:Name="CheckMark"
                        Data="M 2 7 L 6 11 L 14 2"
                        Stroke="#72E3C3"
                        StrokeThickness="2"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>
                  <ContentPresenter Grid.Column="1"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    VerticalAlignment="Center"/>
                  <Path x:Name="SubmenuIndicator"
                        Grid.Column="2"
                        Data="M 0 0 L 5 4 L 0 8 Z"
                        Fill="#A3B8D0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup"
                     Placement="Right"
                     HorizontalOffset="-2"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Fade">
                <Border Background="#000000"
                        BorderBrush="#2E4863"
                        BorderThickness="1"
                        Padding="2"
                        MinWidth="180">
                  <ScrollViewer MaxHeight="520">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted"
                       Value="True">
                <Setter TargetName="ItemBorder"
                        Property="Background"
                        Value="#26384D"/>
                <Setter Property="Foreground"
                        Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked"
                       Value="True">
                <Setter TargetName="CheckMark"
                        Property="Visibility"
                        Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled"
                       Value="False">
                <Setter Property="Foreground"
                        Value="#718198"/>
              </Trigger>
              <Trigger Property="Role"
                       Value="SubmenuHeader">
                <Setter TargetName="SubmenuIndicator"
                        Property="Visibility"
                        Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Margin"
              Value="6,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1"
                    Background="#344255"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground"
              Value="#C8D7E8"/>
      <Setter Property="Background"
              Value="Transparent"/>
      <Setter Property="FontSize"
              Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal"
                        Cursor="Hand">
              <Border x:Name="Box"
                      Width="14"
                      Height="14"
                      Margin="0,0,5,0"
                      CornerRadius="2"
                      BorderBrush="#59728E"
                      BorderThickness="1"
                      Background="#000000"
                      VerticalAlignment="Center">
                <Path x:Name="Mark"
                      Data="M 2 7 L 5.5 10 L 12 3"
                      Stroke="#080C12"
                      StrokeThickness="2"
                      Visibility="Collapsed"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked"
                       Value="True">
                <Setter TargetName="Box"
                        Property="Background"
                        Value="#25C89A"/>
                <Setter TargetName="Box"
                        Property="BorderBrush"
                        Value="#72E3C3"/>
                <Setter TargetName="Mark"
                        Property="Visibility"
                        Value="Visible"/>
                <Setter Property="Foreground"
                        Value="#72E3C3"/>
              </Trigger>
              <Trigger Property="IsMouseOver"
                       Value="True">
                <Setter TargetName="Box"
                        Property="BorderBrush"
                        Value="#F0B90B"/>
                <Setter Property="Foreground"
                        Value="#F0D27A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Margin"
              Value="5"/>
      <Setter Property="Padding"
              Value="7"/>
      <Setter Property="BorderBrush"
              Value="{StaticResource Border}"/>
      <Setter Property="Foreground"
              Value="#A3B8D0"/>
      <Setter Property="FontSize"
              Value="11"/>
      <Setter Property="HeaderTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}"
                       Style="{StaticResource WidgetTitleStyle}"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Margin"
              Value="4"/>
      <Setter Property="Background"
              Value="#000000"/>
      <Setter Property="Foreground"
              Value="#DCE7F4"/>
      <Setter Property="BorderBrush"
              Value="{StaticResource Border}"/>
      <Setter Property="RowBackground"
              Value="#0B111A"/>
      <Setter Property="AlternatingRowBackground"
              Value="#101722"/>
      <Setter Property="GridLinesVisibility"
              Value="Horizontal"/>
      <Setter Property="HeadersVisibility"
              Value="Column"/>
      <Setter Property="IsReadOnly"
              Value="True"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background"
              Value="#000000"/>
      <Setter Property="Foreground"
              Value="#A3B8D0"/>
      <Setter Property="BorderBrush"
              Value="{StaticResource Border}"/>
      <Setter Property="Padding"
              Value="8,7"/>
      <Setter Property="FontWeight"
              Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Background"
              Value="Transparent"/>
      <Setter Property="Foreground"
              Value="#DCE7F4"/>
      <Setter Property="BorderBrush"
              Value="#203044"/>
      <Setter Property="Padding"
              Value="7,5"/>
      <Setter Property="FocusVisualStyle"
              Value="{x:Null}"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground"
              Value="#DCE7F4"/>
      <Setter Property="Background"
              Value="#000000"/>
      <Setter Property="BorderBrush"
              Value="#203044"/>
      <Setter Property="Height"
              Value="30"/>
      <Setter Property="FocusVisualStyle"
              Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected"
                 Value="True">
          <Setter Property="Background"
                  Value="#17334B"/>
          <Setter Property="Foreground"
                  Value="#FFFFFF"/>
        </Trigger>
        <Trigger Property="IsMouseOver"
                 Value="True">
          <Setter Property="Background"
                  Value="#132235"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground"
              Value="#DCE7F4"/>
      <Setter Property="Background"
              Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment"
              Value="Stretch"/>
      <Setter Property="FocusVisualStyle"
              Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected"
                 Value="True">
          <Setter Property="Background"
                  Value="#17334B"/>
          <Setter Property="Foreground"
                  Value="#FFFFFF"/>
        </Trigger>
        <Trigger Property="IsMouseOver"
                 Value="True">
          <Setter Property="Background"
                  Value="#132235"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top"
            Background="#000000"
            BorderBrush="#202020"
            BorderThickness="0,0,0,1"
            Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="OpenTitleText" Text="OPEN"
                     FontSize="21"
                     FontWeight="Bold"
                     Foreground="#F0B90B"/>
          <TextBlock x:Name="TerminalTitleText" Text="TERMINAL"
                     FontSize="21"
                     FontWeight="Bold"
                     Foreground="#DCE7F4"
                     Margin="3,0,18,0"/>
        </StackPanel>
        <Border x:Name="ConnectionStatusBadge"
                Grid.Column="1"
                CornerRadius="10"
                Background="#173F38"
                Padding="8,3"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="LiveDot"
                     Width="7"
                     Height="7"
                     Fill="#25C89A"
                     Margin="0,0,6,0"
                     VerticalAlignment="Center"/>
            <TextBlock x:Name="ConnectionText"
                       Text="CONNECTING"
                       FontSize="11"
                       Foreground="#72E3C3"/>
            <TextBlock Text="  ·  1s REFRESH"
                       FontSize="11"
                       Foreground="#72E3C3"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText"
                   Grid.Column="2"
                   Text="Menyambungkan feed broker…"
                   Foreground="#9FB3CC"
                   VerticalAlignment="Center"
                   Margin="16,0"/>
        <StackPanel Grid.Column="3"
                    Orientation="Horizontal">
          <TextBlock x:Name="DataOnlyLabelText"
                     Text="DATA ONLY"
                     Foreground="#E7B65A"
                     VerticalAlignment="Center"
                     Margin="6"/>
          <Button Content="Refresh"
                  Click="Refresh_Click"/>
          <Button Content="Update SSID"
                  Click="UpdateSsid_Click"/>
          <Button Content="Auto Login"
                  Click="BrowserLogin_Click"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="WorkspaceGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="MarketColumn"
                          Width="232"/>
        <ColumnDefinition x:Name="ChartColumn"
                          Width="2*"/>
        <ColumnDefinition x:Name="ToolsColumn"
                          Width="305"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="MarketListPanel"
              Background="#000000"
              BorderBrush="#202020"
              BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="MarketExplorerTitle"
                       Text="PENCARIAN MARKET (ALL MARKET)"
                       Style="{StaticResource WidgetTitleStyle}"
                       FontSize="11"
                       Margin="8,15,8,4"/>
            <TextBox x:Name="SearchBox"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Cari symbol atau market"/>
            <StackPanel Margin="5,3">
              <WrapPanel HorizontalAlignment="Center">
                <Button Tag="ALL"
                        Content="ALL"
                        FontSize="8"
                        Padding="4,4"
                        Margin="1"
                        Foreground="#F0B90B"
                        Click="GroupFilter_Click"/>
                <Button Tag="OPTION"
                        Content="OPTION"
                        FontSize="8"
                        Padding="4,4"
                        Margin="1"
                        Foreground="#4D9DFF"
                        Click="GroupFilter_Click"/>
                <Button Tag="CURRENCIES"
                        Content="CURRENCIES"
                        FontSize="8"
                        Padding="4,4"
                        Margin="1"
                        Foreground="#25C89A"
                        Click="GroupFilter_Click"/>
                <Button Tag="CRYPTOCURRENCIES"
                        Content="CRYPTOCURRENCIES"
                        FontSize="8"
                        Padding="4,4"
                        Margin="1"
                        Foreground="#C792EA"
                        Click="GroupFilter_Click"/>
              </WrapPanel>
              <WrapPanel HorizontalAlignment="Center">
                <Button Tag="COMMODITIES"
                        Content="COMMODITIES"
                        FontSize="8"
                        Padding="4,4"
                        Margin="1"
                        Foreground="#E7B65A"
                        Click="GroupFilter_Click"/>
                <Button Tag="STOCKS"
                        Content="STOCKS"
                        FontSize="8"
                        Padding="4,4"
                        Margin="1"
                        Foreground="#52B7D8"
                        Click="GroupFilter_Click"/>
                <Button Tag="INDICES"
                        Content="INDICES"
                        FontSize="8"
                        Padding="4,4"
                        Margin="1"
                        Foreground="#F26D78"
                        Click="GroupFilter_Click"/>
                <Button Tag="FAVORITES"
                        Content="FAVORITES"
                        FontSize="8"
                        Padding="4,4"
                        Margin="1"
                        Foreground="#F8B84E"
                        Click="GroupFilter_Click"/>
              </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="MarketCountText"
                       Foreground="#9FB3CC"
                       Margin="14,7"/>
          </StackPanel>
          <ListBox x:Name="MarketList"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="#DCE7F4"
                   SelectionChanged="MarketList_SelectionChanged"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Visible">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="8,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0"
                              Margin="0,0,8,0">
                    <TextBlock Text="{Binding Symbol}"
                               FontFamily="Consolas"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Name}"
                               Foreground="#7890AC"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1"
                              HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                      <TextBlock Text="{Binding Price}"
                                 FontFamily="Consolas"
                                 TextAlignment="Right"/>
                      <Button Tag="{Binding Symbol}"
                              Content="{Binding FavoriteGlyph}"
                              Click="Favorite_Click"
                              Padding="2,0"
                              Margin="4,0,0,0"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#F8B84E"
                              ToolTip="Favorit"/>
                    </StackPanel>
                    <TextBlock Text="{Binding State}"
                               FontSize="10"
                               Foreground="White"
                               TextAlignment="Right"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition x:Name="BottomWidgetsRow"
                         Height="132"
                         MinHeight="96"
                         MaxHeight="300"/>
        </Grid.RowDefinitions>
        <Border Background="#000000"
                BorderBrush="#202020"
                BorderThickness="0,0,0,1"
                Padding="11">
          <Grid x:Name="ChartToolbarGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="SelectedSymbolText"
                         FontFamily="Consolas"
                         FontSize="20"
                         FontWeight="Bold"/>
              <TextBlock x:Name="SelectedNameText"
                         Style="{StaticResource WidgetTitleStyle}"
                         FontSize="12"
                         VerticalAlignment="Center"
                         Margin="10,0"/>
              <Button Content="SYMBOL"
                      Click="OpenMarketSearch_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">
              <TextBlock Text="STRATEGY"
                         Visibility="Collapsed"
                         Foreground="#8492A6"
                         FontSize="10"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Margin="10,0,2,0"/>
              <ComboBox x:Name="StrategyBox"
                        Visibility="Collapsed"
                        Width="175"
                        SelectionChanged="StrategyBox_Changed">
                <ComboBoxItem Content="OFF"
                              IsSelected="True"/>
                <ComboBoxItem Content="Z-SCORE REVERSAL"/>
                <ComboBoxItem Content="EMA 9/21 CROSS"/>
                <ComboBoxItem Content="RSI 14 REVERSAL"/>
                <ComboBoxItem Content="STRUCTURE BREAK"/>
              </ComboBox>
              <Button Content="INDIKATOR"
                      Padding="9,5"
                      Click="Indicators_Click">
                <Button.ContextMenu>
                  <ContextMenu Background="#000000"
                               Foreground="#E5EBF4">
                    <MenuItem Header="INDIKATOR"
                              IsEnabled="False"
                              FontWeight="Bold"/>
                    <Separator/>
                    <MenuItem x:Name="DirectionOverlayBox"
                              Header="EMA 9 / 21"
                              IsCheckable="True"
                              IsChecked="False"
                              Checked="OverlayChanged"
                              Unchecked="OverlayChanged"/>
                    <MenuItem x:Name="RsiOverlayBox"
                              Header="RSI 14"
                              IsCheckable="True"
                              IsChecked="False"
                              Checked="OverlayChanged"
                              Unchecked="OverlayChanged"/>
                    <MenuItem x:Name="BollingerOverlayBox"
                              Header="Bollinger Bands 20, 2"
                              IsCheckable="True"
                              IsChecked="False"
                              Checked="OverlayChanged"
                              Unchecked="OverlayChanged"/>
                    <MenuItem x:Name="AtrOverlayBox"
                              Header="ATR 14"
                              IsCheckable="True"
                              IsChecked="False"
                              Checked="OverlayChanged"
                              Unchecked="OverlayChanged"/>
                    <MenuItem x:Name="LevelsOverlayBox"
                              Header="Support / Resistance"
