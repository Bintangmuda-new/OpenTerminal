<Window x:Class="OpenTerminal.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OPEN TERMINAL BMF" Width="1600" Height="960" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#070B12" Foreground="#E5EBF4">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#101722"/><SolidColorBrush x:Key="Panel2" Color="#151E2B"/><SolidColorBrush x:Key="Border" Color="#26364A"/>
    <Style x:Key="WidgetTitleStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FFFF3030"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="10"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,0,5"/><Style.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" Duration="0:0:4"><LinearColorKeyFrame KeyTime="0:0:0" Value="#FFFF3030"/><LinearColorKeyFrame KeyTime="0:0:1" Value="#FF30FF50"/><LinearColorKeyFrame KeyTime="0:0:2" Value="#FF3080FF"/><LinearColorKeyFrame KeyTime="0:0:3" Value="#FFFF30D0"/><LinearColorKeyFrame KeyTime="0:0:4" Value="#FFFF3030"/></ColorAnimationUsingKeyFrames><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.65" To="1" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></EventTrigger></Style.Triggers></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,6"/><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="Foreground" Value="#B8C7D9"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="#0B111A"/><Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="7,4"/><Setter Property="Background" Value="#151E2B"/><Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><Grid><ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/><Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="#A3B8D0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6"/></Grid></ToggleButton><Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="#101722" BorderBrush="#2E4863" BorderThickness="1" MinWidth="{Binding ActualWidth, ElementName=Toggle}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#151E2B"/><Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="Padding" Value="8,5"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#17334B"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1F3E59"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
    <Style TargetType="MenuItem"><Setter Property="Background" Value="#121A26"/><Setter Property="Foreground" Value="#DCE7F4"/><Setter Property="Padding" Value="8,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="CheckMark" Data="M 2 7 L 6 11 L 14 2" Stroke="#72E3C3" StrokeThickness="2" VerticalAlignment="Center" Visibility="Collapsed"/><ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#26384D"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#718198"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Separator"><Setter Property="Margin" Value="6,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#344255"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C8D7E8"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontSize" Value="11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" Cursor="Hand"><Border x:Name="Box" Width="14" Height="14" Margin="0,0,5,0" CornerRadius="2" BorderBrush="#59728E" BorderThickness="1" Background="#0B111A" VerticalAlignment="Center"><Path x:Name="Mark" Data="M 2 7 L 5.5 10 L 12 3" Stroke="#080C12" StrokeThickness="2" Visibility="Collapsed"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#25C89A"/><Setter TargetName="Box" Property="BorderBrush" Value="#72E3C3"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#72E3C3"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#F0B90B"/><Setter Property="Foreground" Value="#F0D27A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="7"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Foreground" Value="#A3B8D0"/><Setter Property="FontSize" Value="11"/><Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource WidgetTitleStyle}"/></DataTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGrid"><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#0B111A"/><Setter Property="Foreground" Value="#DCE7F4"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="RowBackground" Value="#0B111A"/><Setter Property="AlternatingRowBackground" Value="#101722"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="IsReadOnly" Value="True"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#151E2B"/><Setter Property="Foreground" Value="#A3B8D0"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="8,7"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#DCE7F4"/><Setter Property="BorderBrush" Value="#203044"/><Setter Property="Padding" Value="7,5"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#DCE7F4"/><Setter Property="Background" Value="#0B111A"/><Setter Property="BorderBrush" Value="#203044"/><Setter Property="Height" Value="30"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#17334B"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#132235"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#DCE7F4"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#17334B"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#132235"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#0B111A" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock Text="OPEN" FontSize="21" FontWeight="Bold" Foreground="#F0B90B"/><TextBlock Text="TERMINAL" FontSize="21" FontWeight="Bold" Foreground="#DCE7F4" Margin="3,0,18,0"/></StackPanel>
        <Border Grid.Column="1" CornerRadius="10" Background="#173F38" Padding="8,3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#25C89A" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock x:Name="ConnectionText" Text="CONNECTING" FontSize="11" Foreground="#72E3C3"/><TextBlock Text="  ·  1s REFRESH" FontSize="11" Foreground="#72E3C3"/></StackPanel></Border>
        <TextBlock x:Name="StatusText" Grid.Column="2" Text="Menyambungkan feed broker…" Foreground="#9FB3CC" VerticalAlignment="Center" Margin="16,0"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal"><TextBlock Text="DATA ONLY" Foreground="#E7B65A" VerticalAlignment="Center" Margin="6"/><Button Content="Refresh" Click="Refresh_Click"/><Button Content="Update SSID" Click="UpdateSsid_Click"/><Button Content="Auto Login" Click="BrowserLogin_Click"/></StackPanel>
      </Grid>
    </Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/><ColumnDefinition Width="305"/></Grid.ColumnDefinitions>
      <Border Background="#0B111A" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"><DockPanel>
        <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="MarketExplorerTitle" Text="PENCARIAN MARKET (ALL MARKET)" Style="{StaticResource WidgetTitleStyle}" FontSize="11" Margin="8,15,8,4"/><TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Cari symbol atau market"/><StackPanel Margin="5,3"><WrapPanel HorizontalAlignment="Center"><Button Tag="ALL" Content="ALL" FontSize="8" Padding="4,4" Margin="1" Foreground="#F0B90B" Click="GroupFilter_Click"/><Button Tag="OPTION" Content="OPTION" FontSize="8" Padding="4,4" Margin="1" Foreground="#4D9DFF" Click="GroupFilter_Click"/><Button Tag="CURRENCIES" Content="CURRENCIES" FontSize="8" Padding="4,4" Margin="1" Foreground="#25C89A" Click="GroupFilter_Click"/><Button Tag="CRYPTOCURRENCIES" Content="CRYPTOCURRENCIES" FontSize="8" Padding="4,4" Margin="1" Foreground="#C792EA" Click="GroupFilter_Click"/></WrapPanel><WrapPanel HorizontalAlignment="Center"><Button Tag="COMMODITIES" Content="COMMODITIES" FontSize="8" Padding="4,4" Margin="1" Foreground="#E7B65A" Click="GroupFilter_Click"/><Button Tag="STOCKS" Content="STOCKS" FontSize="8" Padding="4,4" Margin="1" Foreground="#52B7D8" Click="GroupFilter_Click"/><Button Tag="INDICES" Content="INDICES" FontSize="8" Padding="4,4" Margin="1" Foreground="#F26D78" Click="GroupFilter_Click"/><Button Tag="FAVORITES" Content="FAVORITES" FontSize="8" Padding="4,4" Margin="1" Foreground="#F8B84E" Click="GroupFilter_Click"/></WrapPanel></StackPanel><TextBlock x:Name="MarketCountText" Foreground="#9FB3CC" Margin="14,7"/></StackPanel>
        <ListBox x:Name="MarketList" Background="Transparent" BorderThickness="0" Foreground="#DCE7F4" SelectionChanged="MarketList_SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="{Binding Symbol}" FontFamily="Consolas" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Name}" Foreground="#7890AC" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding Price}" FontFamily="Consolas" TextAlignment="Right"/><Button Tag="{Binding Symbol}" Content="{Binding FavoriteGlyph}" Click="Favorite_Click" Padding="2,0" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#F8B84E" ToolTip="Favorit"/></StackPanel><TextBlock Text="{Binding State}" FontSize="10" Foreground="#36CFA1" TextAlignment="Right"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel></Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="132"/></Grid.RowDefinitions>
        <Border Background="#0C121C" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock x:Name="SelectedSymbolText" FontFamily="Consolas" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="SelectedNameText" Style="{StaticResource WidgetTitleStyle}" FontSize="12" VerticalAlignment="Center" Margin="10,0"/><Button Content="SYMBOL" Click="OpenMarketSearch_Click"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="STRATEGY" Visibility="Collapsed" Foreground="#8492A6" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,2,0"/><ComboBox x:Name="StrategyBox" Visibility="Collapsed" Width="175" SelectionChanged="StrategyBox_Changed"><ComboBoxItem Content="OFF" IsSelected="True"/><ComboBoxItem Content="Z-SCORE REVERSAL"/><ComboBoxItem Content="EMA 9/21 CROSS"/><ComboBoxItem Content="RSI 14 REVERSAL"/><ComboBoxItem Content="STRUCTURE BREAK"/></ComboBox><Button Content="INDIKATOR" Padding="9,5" Click="Indicators_Click"><Button.ContextMenu><ContextMenu Background="#121A26" Foreground="#E5EBF4"><MenuItem Header="INDIKATOR" IsEnabled="False" FontWeight="Bold"/><Separator/><MenuItem x:Name="DirectionOverlayBox" Header="EMA 9 / 21" IsCheckable="True" IsChecked="True" Checked="OverlayChanged" Unchecked="OverlayChanged"/><MenuItem x:Name="RsiOverlayBox" Header="RSI 14" IsCheckable="True" IsChecked="False" Checked="OverlayChanged" Unchecked="OverlayChanged"/><MenuItem x:Name="BollingerOverlayBox" Header="Bollinger Bands 20, 2" IsCheckable="True" IsChecked="False" Checked="OverlayChanged" Unchecked="OverlayChanged"/><MenuItem x:Name="AtrOverlayBox" Header="ATR 14" IsCheckable="True" IsChecked="False" Checked="OverlayChanged" Unchecked="OverlayChanged"/><MenuItem x:Name="LevelsOverlayBox" Header="Support / Resistance" IsCheckable="True" IsChecked="True" Checked="OverlayChanged" Unchecked="OverlayChanged"/><MenuItem x:Name="StructureOverlayBox" Header="BOS / CHoCH" IsCheckable="True" IsChecked="False" Checked="OverlayChanged" Unchecked="OverlayChanged"/><MenuItem x:Name="SlShOverlayBox" Header="SL / SH · 4 candle" IsCheckable="True" IsChecked="False" Checked="OverlayChanged" Unchecked="OverlayChanged"/><Separator/><MenuItem Header="METRIK" IsEnabled="False" FontWeight="Bold"/><MenuItem Header="OHLC · RSI · ATR · candle timer" IsEnabled="False"/><Separator/><MenuItem Header="STRATEGI" IsEnabled="False" FontWeight="Bold"/><MenuItem x:Name="TrendStrategyBox" Header="Trend" IsCheckable="True" IsChecked="False" Checked="OverlayChanged" Unchecked="OverlayChanged"/><MenuItem x:Name="MomentumStrategyBox" Header="Momentum Reversal" IsCheckable="True" IsChecked="False" Checked="OverlayChanged" Unchecked="OverlayChanged"/><MenuItem x:Name="BollingerStrategyBox" Header="Bollinger Re-entry" IsCheckable="True" IsChecked="False" Checked="OverlayChanged" Unchecked="OverlayChanged"/><MenuItem x:Name="RejectionStrategyBox" Header="Support / Resistance Rejection" IsCheckable="True" IsChecked="False" Checked="OverlayChanged" Unchecked="OverlayChanged"/><MenuItem x:Name="BreakoutStrategyBox" Header="Volatility Breakout" IsCheckable="True" IsChecked="False" Checked="OverlayChanged" Unchecked="OverlayChanged"/></ContextMenu></Button.ContextMenu></Button><Button Content="VIEW" Padding="9,5" Click="Indicators_Click"><Button.ContextMenu><ContextMenu Background="#121A26" Foreground="#E5EBF4"><MenuItem Header="TAMPILAN" IsEnabled="False" FontWeight="Bold"/><Separator/><MenuItem Header="Zoom In" Click="ChartZoomIn_Click"/><MenuItem Header="Zoom Out" Click="ChartZoomOut_Click"/><MenuItem Header="Reset Chart" Click="ChartReset_Click"/></ContextMenu></Button.ContextMenu></Button><TextBlock Text="TIMEFRAME" Foreground="#8492A6" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/><ComboBox x:Name="TimeframeBox" Width="66" Foreground="#FFFFFF" SelectionChanged="TimeframeBox_SelectionChanged"><ComboBoxItem Content="1m" IsSelected="True"/></ComboBox><CheckBox x:Name="AutoEndBox" Visibility="Collapsed" IsChecked="True" Checked="AutoEndChanged" Unchecked="AutoEndChanged"/><TextBlock Text="SCROLL ZOOM · DRAG PAN" Foreground="#8492A6" FontSize="10" VerticalAlignment="Center" Margin="10,0,2,0"/><TextBlock Text="REALTIME" Foreground="#F8B84E" FontWeight="Bold" Margin="10,8,2,0"/></StackPanel><TextBlock Grid.Column="2" Text="CHART" Style="{StaticResource WidgetTitleStyle}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,0,2,0"/></Grid></Border>
        <Grid Grid.Row="1" Background="#0B111A" PreviewMouseWheel="PriceChart_MouseWheel"><Canvas x:Name="PriceChart" Background="#0B111A" Visibility="Collapsed" SizeChanged="PriceChart_SizeChanged" MouseWheel="PriceChart_MouseWheel" MouseDown="PriceChart_MouseDown" MouseMove="PriceChart_MouseMove" MouseUp="PriceChart_MouseUp"/><Border x:Name="ChartStatusOverlay" Panel.ZIndex="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#D9070B12" Visibility="Visible"><TextBlock x:Name="ChartLoadingText" Text="LOADING MARKET..." HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Foreground="#8492A6"/></Border><Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Background="#111B28" CornerRadius="4" Padding="8"><TextBlock x:Name="ChartInfoText" FontFamily="Consolas" Foreground="#A3B8D0" FontSize="11"/></Border><Border x:Name="ChartAlertBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Background="#123B33" BorderBrush="#25C89A" BorderThickness="1" CornerRadius="5" Padding="10,6" Visibility="Collapsed" Panel.ZIndex="20"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ChartAlertTime" FontFamily="Consolas" FontSize="10" Foreground="#72E3C3" Margin="0,0,9,0"/><TextBlock x:Name="ChartAlertMessage" Foreground="#FFFFFF" FontSize="11" TextWrapping="Wrap" MaxWidth="560"/></StackPanel></Border></Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border BorderBrush="#2E4863" BorderThickness="1" CornerRadius="5" Margin="4" Background="#0E1621"><Grid Margin="8,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.ColumnSpan="2" Text="SIGNAL" Style="{StaticResource WidgetTitleStyle}" HorizontalAlignment="Center" Margin="0,0,0,3"/><StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="4,0,0,0"><TextBlock Text="NEXT CANDLE · UNPROVEN" Foreground="#9FB3CC" FontSize="8" ToolTip="Signals lock before entry candle and do not repaint."/><TextBlock x:Name="SignalText" Text="WAIT" FontFamily="Consolas" FontSize="34" FontWeight="Bold" Foreground="#59728E"/><TextBlock x:Name="SignalReason" Text="menunggu data" Foreground="#9FB3CC" FontSize="11" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0"><Ellipse x:Name="SignalStatusDot" Width="6" Height="6" Fill="#F0B90B" Margin="0,0,4,0"/><TextBlock x:Name="SignalStatusText" Text="SYNCING" FontSize="8" FontWeight="Bold" Foreground="#E7B65A"/></StackPanel><TextBlock x:Name="SignalClock" Grid.Row="1" Grid.Column="1" Text="-:--" FontFamily="Consolas" FontSize="46" FontWeight="Bold" Foreground="#E7EDF5" VerticalAlignment="Center" Margin="10,0,10,0"/></Grid></Border><Border Grid.Column="1" BorderBrush="#2E4863" BorderThickness="1" CornerRadius="5" Margin="4" Background="#0E1621"><Grid Margin="10,3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.ColumnSpan="2" Text="LIVE CANDLE" Style="{StaticResource WidgetTitleStyle}" Margin="0"/><TextBlock x:Name="QuoteTickAge" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="9" Foreground="#9FB3CC" VerticalAlignment="Center"/></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="QuoteArrow" Text="·" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Foreground="#59728E" VerticalAlignment="Center" Margin="0,0,7,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="QuoteText" Text="Menunggu" FontFamily="Consolas" FontSize="19" FontWeight="Bold" Foreground="#E7EDF5"/><TextBlock x:Name="QuoteDelta" Text="" FontFamily="Consolas" FontSize="10" Foreground="#9FB3CC"/></StackPanel></Grid><Grid Grid.Row="2" Height="6" Margin="0,3"><Border Background="#16202E" CornerRadius="3"/><Border x:Name="QuotePressureBar" Background="#59728E" CornerRadius="3" HorizontalAlignment="Left" Width="0"/></Grid><TextBlock x:Name="QuoteFlipText" Grid.Row="3" Text="" FontFamily="Consolas" FontSize="9" Foreground="#9FB3CC" TextWrapping="Wrap" Margin="0,0,0,2"/><TextBlock x:Name="QuoteSignalText" Grid.Row="4" Text="Signal: NO TRADE" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#E7B65A" HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" ToolTip="Candle M1 tertutup: gerak minimal 3 pip memberi BUY/SELL. Di bawah 3 pip memberi NO TRADE, berlaku untuk candle M1 berikutnya."/></Grid></Border><Border x:Name="StructureInfoBorder" Grid.Column="2" BorderBrush="#2E4863" BorderThickness="1" CornerRadius="5" Margin="4" Background="#0E1621"><StackPanel Margin="8,5"><TextBlock Text="STRUCTURE · PATTERN" Style="{StaticResource WidgetTitleStyle}" FontSize="11" Margin="0,0,0,5"/><TextBlock x:Name="StructCandlePattern" FontFamily="Segoe UI" FontSize="10" Foreground="#C1CEDD" Margin="0,2" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StructChartPattern" FontFamily="Segoe UI" FontSize="10" Foreground="#C1CEDD" Margin="0,2" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StructTrend" FontFamily="Segoe UI" FontSize="10" Foreground="#C1CEDD" Margin="0,2" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StructBos" FontFamily="Segoe UI" FontSize="10" Foreground="#C1CEDD" Margin="0,2" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StructSupportResistance" FontFamily="Segoe UI" FontSize="9" Foreground="#C1CEDD" Margin="0,2" TextTrimming="CharacterEllipsis" ToolTip="Support hijau, resistance merah; angka menunjukkan jarak pip dari harga."/><TextBlock x:Name="StructSignal" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Stretch" Margin="0,5,0,0" Foreground="#E7B65A" ToolTip="Sinyal confluence dari lima data: candle pattern, chart pattern, trend, B.O.S, support/resistance. Minimal 3 dari 5 faktor searah."/></StackPanel></Border><Border Grid.Column="3" BorderBrush="#2E4863" BorderThickness="1" CornerRadius="5" Margin="4" Background="#0E1621"><StackPanel Margin="7,5"><TextBlock Text="MOMENTUM · CANDLE CLOCK" Style="{StaticResource WidgetTitleStyle}"/><StackPanel><TextBlock x:Name="BinaryMomentumText" FontFamily="Consolas" FontSize="12" Padding="7,7,7,0"/><TextBlock x:Name="BinaryTimingText" FontFamily="Consolas" FontSize="12" Padding="7,2,7,7"/></StackPanel></StackPanel></Border></Grid>
      </Grid>
      <Border Grid.Column="2" Background="#0B111A" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="230"/><RowDefinition Height="*"/><RowDefinition Height="230"/></Grid.RowDefinitions><TabControl Background="#0B111A" BorderBrush="{StaticResource Border}"><TabItem Header="FEED"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="FeedText" FontFamily="Consolas" Padding="7" TextWrapping="Wrap"/><Border x:Name="MarketQualityBorder" Margin="7,2" Background="#173F38" BorderBrush="#25C89A" BorderThickness="1" CornerRadius="4" Padding="7,5"><TextBlock x:Name="MarketQualityText" FontFamily="Consolas" Foreground="#8FA8C4" FontSize="10"/></Border><TextBlock Text="Jurnal lokal menyimpan raw tick dan candle M1." Foreground="#9FB3CC" TextWrapping="Wrap" Margin="7" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="4"><Button Content="Buka Folder Data" Click="OpenDataFolder_Click"/><Button Content="Export Tick CSV" Click="ExportTicks_Click"/></StackPanel></StackPanel></ScrollViewer></TabItem><TabItem Header="RESULT" IsSelected="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#0E1621" BorderBrush="#2E4863" BorderThickness="0,0,0,1" Padding="10,8"><StackPanel><TextBlock Text="WINRATE SINYAL" Foreground="#9FB3CC" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ResultRateText" Text="—" FontFamily="Consolas" FontSize="38" FontWeight="Bold" Foreground="#9FB3CC"/><TextBlock x:Name="ResultNoteText" Text="Belum ada entry" Foreground="#9FB3CC" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border><Grid Grid.Row="1" Margin="8,8,8,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ENTRY" Foreground="#9FB3CC" FontSize="9"/><TextBlock x:Name="ResultTotalText" Text="0" FontFamily="Consolas" FontSize="17" Foreground="#E7EDF5"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="PROFIT" Foreground="#9FB3CC" FontSize="9"/><TextBlock x:Name="ResultWinText" Text="0" FontFamily="Consolas" FontSize="17" Foreground="#25C89A"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="LOSS" Foreground="#9FB3CC" FontSize="9"/><TextBlock x:Name="ResultLossText" Text="0" FontFamily="Consolas" FontSize="17" Foreground="#F45B69"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="DRAW" Foreground="#9FB3CC" FontSize="9"/><TextBlock x:Name="ResultDrawText" Text="0" FontFamily="Consolas" FontSize="17" Foreground="#E7B65A"/></StackPanel></Grid><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5,2"><Button Content="Buka Jurnal" Click="OpenJournal_Click" ToolTip="data/signal-journal.csv"/><Button Content="Reset" Click="ResultReset_Click" ToolTip="Kosongkan statistik sesi ini"/></StackPanel><TextBlock Grid.Row="3" Margin="10,6" Foreground="#9FB3CC" FontSize="10" TextWrapping="Wrap" Text="Hasil dihitung dari close vs open candle entry. DRAW = candle flat, stake kembali. Statistik ini sesi berjalan saja; riwayat penuh ada di signal-journal.csv. Filter volatilitas + z-score: 50,61% holdout (batas bawah 95% 49,7%). Tetap UNPROVEN. Angka di bawah 100 entry belum berarti."/></Grid></TabItem><TabItem Header="NEWS"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="NewsStatusText" Foreground="#9FB3CC" FontSize="10" Margin="5"/><DataGrid x:Name="NewsGrid" Grid.Row="1" AutoGenerateColumns="True" CanUserAddRows="False"/></Grid></TabItem><TabItem Header="TAPE"><DataGrid x:Name="TapeGrid" AutoGenerateColumns="True" CanUserAddRows="False"/></TabItem></TabControl><GroupBox Grid.Row="1" Header="NOTIFIKASI"><ListBox x:Name="ChartAlertList" BorderThickness="0" Background="Transparent" Foreground="#DCE7F4" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,6"><TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="10" Foreground="#9FB3CC"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></GroupBox><GroupBox Grid.Row="2" Header="SL / SH LOCK"><TextBlock Text="Marker terkunci saat candle selesai. Database lokal menjaga marker tetap ada setelah aplikasi dibuka ulang." TextWrapping="Wrap" Foreground="#9FB3CC" Padding="7"/></GroupBox></Grid></Border>
      <Border x:Name="BottomAlertBorder" Grid.ColumnSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Background="#123B33" BorderBrush="#25C89A" BorderThickness="1" CornerRadius="6" Padding="12,8" Visibility="Collapsed" Panel.ZIndex="20">
