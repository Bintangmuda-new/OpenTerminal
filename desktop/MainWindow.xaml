                         FontSize="9"
                         Foreground="#AFC0D2"
                         LineHeight="16"/>
              <TextBlock x:Name="QuoteFlipText"
                         Grid.Row="5"
                         Text=""
                         FontFamily="Consolas"
                         FontSize="9"
                         Foreground="#9FB3CC"
                         LineHeight="16"
                         TextWrapping="Wrap"
                         Margin="0,5,0,0"/>
